datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  VERIFIED_SELLER
  MODERATOR
  ADMIN
}

enum ArticleStatus {
  DRAFT
  PENDING_VALIDATION
  AVAILABLE
  RESERVED
  SOLD
  REMOVED
}

enum ItemCondition {
  NEW_WITH_TAG
  NEW_WITHOUT_TAG
  VERY_GOOD_STATE
  GOOD_STATE
  FAIR_STATE
}

enum DeliveryMethod {
  HAND_DELIVERY
  TAXI_BROUSSE_PARCEL
  LOCAL_COURIER
}

enum PaymentType {
  CASH_ON_DELIVERY
  MVOLA
  ORANGE_MONEY
  AIRTEL_MONEY
}

enum OrderStatus {
  PENDING
  ACCEPTED
  SHIPPED
  DELIVERED
  CANCELLED
  DISPUTED
}

enum VideoStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum LiveStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum FlashOrderStatus {
  WAITING_HOST_CONFIRMATION
  CONFIRMED
  EXPIRED
  CANCELLED
}

enum ReportReason {
  SCAM_OR_FRAUD
  INAPPROPRIATE_CONTENT
  COUNTERFEIT
  PROHIBITED_ITEM
  HARASSMENT
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
  ACTION_TAKEN
}

model User {
  id                String          @id @default(uuid())
  phoneNumber       String          @unique
  phoneVerified     Boolean         @default(false)
  fullName          String
  username          String?         @unique
  avatarUrl         String?
  bio               String?
  city              String
  neighborhood      String?
  role              Role            @default(USER)
  isBanned          Boolean         @default(false)
  banReason         String?
  trustScore        Float           @default(5.0)
  totalSalesCount   Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  articles          Article[]
  videos            Video[]
  livesAsHost       LiveSession[]   @relation("HostLives")
  ordersPlaced      Order[]         @relation("BuyerOrders")
  ordersReceived    Order[]         @relation("SellerOrders")
  flashOrders       LiveOrder[]     @relation("BuyerFlashOrders")
  reviewsGiven      Review[]        @relation("ReviewsWritten")
  reviewsReceived   Review[]        @relation("ReviewsReceived")
  likes             Like[]
  favorites         Favorite[]
  comments          Comment[]
  chatMessages      LiveChatMessage[]
  reportsFiled      Report[]        @relation("Reporter")
  reportsAgainst    Report[]        @relation("ReportedUser")
  followers         Follow[]        @relation("Followers")
  following         Follow[]        @relation("Following")
  refreshTokens     RefreshToken[]
  videoViews        VideoView[]

  @@index([phoneNumber])
  @@index([city])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model OtpVerification {
  id          String   @id @default(uuid())
  phoneNumber String
  codeHash    String
  attempts    Int      @default(0)
  expiresAt   DateTime
  consumed    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([phoneNumber, expiresAt])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
}

model Article {
  id              String           @id @default(uuid())
  sellerId        String
  seller          User             @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title           String
  description     String
  price           Int
  category        String
  size            String?
  condition       ItemCondition
  city            String
  status          ArticleStatus    @default(AVAILABLE)
  deliveryOptions DeliveryMethod[]
  isWhatsAppContactEnabled Boolean @default(true)
  viewsCount      Int              @default(0)
  favoritesCount  Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  images          ArticleImage[]
  video           Video?
  favorites       Favorite[]
  orders          Order[]
  liveProducts    LiveProduct[]

  @@index([category, status])
  @@index([city, status])
  @@index([price])
}

model ArticleImage {
  id          String   @id @default(uuid())
  articleId   String
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  url         String
  thumbnailUrl String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([articleId])
}

model Video {
  id              String       @id @default(uuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  articleId       String?      @unique
  article         Article?     @relation(fields: [articleId], references: [id], onDelete: SetNull)
  bunnyVideoId    String?      @unique
  hlsPlaylistUrl  String?
  thumbnailUrl    String
  durationSeconds Float
  status          VideoStatus  @default(UPLOADING)
  viewsCount      Int          @default(0)
  likesCount      Int          @default(0)
  commentsCount   Int          @default(0)
  sharesCount     Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  likes           Like[]
  comments        Comment[]
  views           VideoView[]

  @@index([status, createdAt])
}

model VideoView {
  id        String   @id @default(uuid())
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipHash    String
  createdAt DateTime @default(now())

  @@index([videoId, createdAt])
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, videoId])
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, articleId])
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  userId    String
  videoId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([videoId])
}

model LiveSession {
  id             String            @id @default(uuid())
  hostId         String
  host           User              @relation("HostLives", fields: [hostId], references: [id], onDelete: Cascade)
  title          String
  status         LiveStatus        @default(SCHEDULED)
  scheduledStart DateTime?
  startedAt      DateTime?
  endedAt        DateTime?
  livekitRoom    String            @unique
  replayUrl      String?
  peakViewers    Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  products       LiveProduct[]
  messages       LiveChatMessage[]
  flashOrders    LiveOrder[]

  @@index([status, startedAt])
}

model LiveProduct {
  id            String       @id @default(uuid())
  liveSessionId String
  liveSession   LiveSession  @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  articleId     String
  article       Article      @relation(fields: [articleId], references: [id], onDelete: Cascade)
  isPinned      Boolean      @default(false)
  pinnedAt      DateTime?
  sortOrder     Int          @default(0)
  flashOrders   LiveOrder[]

  @@index([liveSessionId, isPinned])
}

model LiveOrder {
  id              String           @id @default(uuid())
  liveSessionId   String
  liveSession     LiveSession      @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  liveProductId   String
  liveProduct     LiveProduct      @relation(fields: [liveProductId], references: [id], onDelete: Cascade)
  buyerId         String
  buyer           User             @relation("BuyerFlashOrders", fields: [buyerId], references: [id], onDelete: Cascade)
  queuePosition   Int
  status          FlashOrderStatus @default(WAITING_HOST_CONFIRMATION)
  priceSnapshot   Int
  createdAt       DateTime         @default(now())

  @@index([liveSessionId, liveProductId, queuePosition])
}

model LiveChatMessage {
  id            String       @id @default(uuid())
  liveSessionId String
  liveSession   LiveSession  @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  message       String
  isHostAction  Boolean      @default(false)
  createdAt     DateTime     @default(now())

  @@index([liveSessionId, createdAt])
}

model Order {
  id             String         @id @default(uuid())
  articleId      String
  article        Article        @relation(fields: [articleId], references: [id])
  buyerId        String
  buyer          User           @relation("BuyerOrders", fields: [buyerId], references: [id])
  sellerId       String
  seller         User           @relation("SellerOrders", fields: [sellerId], references: [id])
  status         OrderStatus    @default(PENDING)
  totalAmount    Int
  deliveryMethod DeliveryMethod
  paymentType    PaymentType
  shippingDetails Json?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  review         Review?

  @@index([buyerId])
  @@index([sellerId])
}

model Review {
  id         String   @id @default(uuid())
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation("ReviewsWritten", fields: [authorId], references: [id])
  targetId   String
  target     User     @relation("ReviewsReceived", fields: [targetId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  @@index([targetId])
}

model Report {
  id             String       @id @default(uuid())
  reporterId     String
  reporter       User         @relation("Reporter", fields: [reporterId], references: [id])
  reportedUserId String?
  reportedUser   User?        @relation("ReportedUser", fields: [reportedUserId], references: [id])
  targetType     String
  targetId       String
  reason         ReportReason
  description    String?
  status         ReportStatus @default(PENDING)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status])
}
