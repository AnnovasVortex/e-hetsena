# Base de données PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ehetsena_db?schema=public"

# Redis (Cache, Sessions, Lock Live Shopping)
REDIS_URL="redis://localhost:6379"

# Sécurité JWT
JWT_SECRET="ehetsena_jwt_super_secret_key_change_in_production_2026"

# Passerelle SMS Madagascar (Laisser vide en dev pour afficher le code dans la console)
NODE_ENV="development"
SMS_GATEWAY_URL=""
SMS_GATEWAY_API_KEY=""

# Stockage Photos Cloudflare R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="e-hetsena-photos"
R2_PUBLIC_DOMAIN="https://photos.e-hetsena.mg"

# VOD Bunny Stream
BUNNY_STREAM_API_KEY=""
BUNNY_STREAM_LIBRARY_ID=""
BUNNY_STREAM_CDN_HOSTNAME="vz-xxxxxx.b-cdn.net"

# LiveKit WebRTC (Serveur Live Shopping)
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"
LIVEKIT_URL="ws://localhost:7880"
